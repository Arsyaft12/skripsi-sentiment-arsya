\begin_layout Section
Kajian Teori dan Teknologi Pendukung
\end_layout

\begin_layout Subsection
Analisis Sentimen
\end_layout

\begin_layout Standard
Analisis sentimen adalah cabang dari Natural Language Processing (NLP) yang bertujuan mengidentifikasi dan mengekstraksi opini,
 emosi,
 atau sikap yang terkandung dalam suatu teks,
 kemudian mengklasifikasikannya ke dalam kategori tertentu,
 misalnya positif,
 negatif,
 atau netral.
 Dalam konteks 
\emph on
e-commerce
\emph default
,
 analisis sentimen banyak diterapkan pada ulasan produk untuk mengetahui kecenderungan kepuasan pelanggan secara agregat tanpa harus membaca setiap ulasan satu per satu,
 sebagaimana ditunjukkan pada seluruh penelitian terdahulu di Sub-bab 2.1.
\end_layout

\begin_layout Subsection
Text Preprocessing
\end_layout

\begin_layout Standard
Text preprocessing adalah rangkaian tahapan yang mengubah teks mentah menjadi bentuk yang lebih terstruktur dan siap diproses oleh algoritma 
\emph on
machine learning
\emph default
.
 Berdasarkan praktik yang diterapkan Sanjaya,
 dkk.
 (2023),
 Apriyani,
 dkk.
 (2024),
 maupun Zahra,
 dkk.
 (2026),
 tahapan preprocessing yang umum diterapkan pada teks berbahasa Indonesia meliputi:
\end_layout

\begin_layout Quote
- 
\emph on
Case folding
\emph default
,
 yaitu penyeragaman huruf menjadi huruf kecil (lowercase) agar kata yang sama tidak dianggap berbeda hanya karena perbedaan kapitalisasi.
\end_layout

\begin_layout Quote
- Penghapusan karakter khusus,
 yaitu menghilangkan tanda baca,
 angka,
 dan simbol non-alfanumerik menggunakan pencocokan pola (regular expression) yang tidak relevan terhadap makna sentimen.
\end_layout

\begin_layout Quote
- 
\emph on
Stopword removal
\emph default
,
 yaitu penghapusan kata-kata umum yang tidak memiliki bobot makna signifikan terhadap sentimen,
 seperti 
\begin_inset Quotes qls
\end_inset

dan
\begin_inset Quotes qrs
\end_inset

,
 
\begin_inset Quotes qls
\end_inset

yang
\begin_inset Quotes qrs
\end_inset

,
 dan 
\begin_inset Quotes qls
\end_inset

di
\begin_inset Quotes qrs
\end_inset

,
 menggunakan kamus stopword bahasa Indonesia.
\end_layout

\begin_layout Quote
- 
\emph on
Stemming
\emph default
,
 yaitu proses pengubahan kata berimbuhan menjadi kata dasarnya,
 misalnya kata 
\begin_inset Quotes qls
\end_inset

pengiriman
\begin_inset Quotes qrs
\end_inset

 menjadi 
\begin_inset Quotes qls
\end_inset

kirim
\begin_inset Quotes qrs
\end_inset

,
 untuk mengurangi variasi bentuk kata dari akar kata yang sama.
 
\end_layout

\begin_layout Subsection
